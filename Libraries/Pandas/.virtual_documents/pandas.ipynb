import pandas as pd
import numpy as np
s = pd.Series([1,2,3,4]) # Here label and index are same values
print(s, type(s))
 #index - position
 # label - named index
s = pd.Series([1,2,3,4] , index = ["Srihari","Surya","Ajay","Nishith"])
print(s)

print(s["Surya"])
# print(s[1])
#Both give same op but accessing by index is deprecated when we name labels we should use s.iloc[idx]
print(s.iloc[1])
print(s.index)





s = pd.Series(['Good boy',2,3,4] , index = ["Srihari",2.50,True,1]) # Homogeneous
print(s)

s1 = pd.Series([1,2,3,4]) 
s2 = pd.Series([1,2,3,4])
print(s1 + s2) # supports vectorization
s1[0] = 100
print(s1)
reduced_s1 = s1.drop(0)
print(reduced_s1)
